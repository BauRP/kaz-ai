# Static headers: apply only to Cloudflare asset responses, not Worker-generated API.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Preview must not compete with the actual website in search results.
/preview.html
  X-Robots-Tag: noindex, follow
/preview
  X-Robots-Tag: noindex, follow

# Static informational content has no JavaScript and can use a restrictive CSP.
/about/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/capabilities/*
