{
  "name": "kaz-ai",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "main": "./src/index.js",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    { "name":"CHAT_IP_LIMITER", "namespace_id":"1201201", "simple":{"limit":6,"period":60} },
    { "name":"CHAT_GLOBAL_LIMITER", "namespace_id":"1201202", "simple":{"limit":30,"period":60} }
  ]
}
