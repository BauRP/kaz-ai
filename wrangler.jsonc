{
  "name": "kaz-ai",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "main": "./src/index.js",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SHARED_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 24,
        "period": 60
      }
    }
  ]
}
